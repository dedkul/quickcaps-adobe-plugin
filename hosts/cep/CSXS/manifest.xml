<?xml version="1.0" encoding="UTF-8"?>
<!--
  QuickCaps for Premiere Pro 2022 and newer (CEP 11+). Premiere 2026 can
  load this too while it still supports CEP; the UXP build is the long-term
  one there.
-->
<ExtensionManifest Version="11.0" ExtensionBundleId="com.quickcaps.cep" ExtensionBundleVersion="0.9.0" ExtensionBundleName="QuickCaps"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.quickcaps.cep.panel" Version="0.9.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.quickcaps.cep.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node does the Sarvam requests (no browser CORS rules) and file I/O. -->
            <Parameter>--enable-nodejs</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>QuickCaps</Menu>
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>380</Width>
            </Size>
            <MinSize>
              <Height>260</Height>
              <Width>280</Width>
            </MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
