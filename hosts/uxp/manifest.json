{
  "manifestVersion": 5,
  "id": "com.quickcaps.panel",
  "name": "QuickCaps",
  "version": "0.10.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "all"
      ],
      "species": [
        "generic"
      ]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "quickcaps-main",
      "label": {
        "default": "QuickCaps"
      },
      "minimumSize": {
        "width": 280,
        "height": 260
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 640
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.sarvam.ai",
        "https://api.github.com"
      ]
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": []
    },
    "localFileSystem": "plugin"
  }
}
